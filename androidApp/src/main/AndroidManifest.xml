<?xml version="1.0" encoding="utf-8"?>
<!--
  Jarvis "Kale" (fortress). This app MUST NOT have internet access: INTERNET and
  ACCESS_NETWORK_STATE are removed even if a library asks for them, and CI
  (tools/check-no-internet.sh) fails the build if they ever appear in the APK.
  Downloads go through the separate "Kapı" APK, guarded by a signature permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" tools:node="remove" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Camera view: frames are analysed on the phone and never stored or sent. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- "Annemi ara" / "Ahmet'e mesaj at": the number is looked up on the phone (asked only then).
         Messages are only prepared in the composer (no SEND_SMS); the user presses send. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- "Ahmet'i ara" places the call (asked once at the first call); refused → the dialer opens instead. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Tablets without a SIM can still install Rick; calls then open nothing. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- The floating Rick over other apps (Settings → Ekranda Rick); off until the user turns it on. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Defined by both Kale and Kapı (same signing key) so install order does not matter. -->
    <permission
        android:name="io.github.ahmetdurmus1218.jarvis.permission.GATE"
        android:description="@string/gate_permission_description"
        android:label="@string/gate_permission_label"
        android:protectionLevel="signature" />
    <uses-permission android:name="io.github.ahmetdurmus1218.jarvis.permission.GATE" />

    <queries>
        <package android:name="io.github.ahmetdurmus1218.jarvis.gate" />
        <!-- Apps a search can be handed to ("YouTube'dan … aç"); they go online, Rick does not. -->
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.spotify.music" />
        <!-- The launcher apps the user may pick for hand control (Settings → Ekranda Rick). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".android.JarvisApplication"
        android:allowBackup="false"
        tools:replace="android:allowBackup,android:label"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jarvis"
        android:usesCleartextTraffic="false">

        <!-- LiteRT-LM GPU backend (OpenCL); optional, CPU is used when missing. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />

        <activity
            android:name=".android.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".android.BubbleService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating assistant face over other apps, started and stopped by the user" />
        </service>
        <!-- Keeps Rick alive during a long approved download (the transfer itself runs in Rick Kapı). -->
        <service
            android:name=".android.DownloadKeeper"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Hands drive the chosen apps (never banks / messengers); it does not read the screen. -->
        <service
            android:name=".android.RickAccessibility"
            android:exported="true"
            android:label="Rick el kontrolü"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/rick_accessibility" />
        </service>
    </application>
</manifest>
